PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/tellinguan
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=https://your-user-frontend.vercel.app
ADMIN_URL=https://your-admin-frontend.vercel.app
ML_SERVER_URL=https://your-ml-server.railway.app

# Database Encryption Configuration (Uses ChaCha20-Poly1305)
DB_ENCRYPTION_KEY=replace_with_a_32_character_encryption_key

# Admin dashboard login (backend verifies these — see POST /api/auth/admin-login)
# Generate ADMIN_PASSWORD_HASH with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash

# Cloudinary (used for audio question uploads — see routes/uploadRoutes.js)
CLOUDINARY_CLOUD_NAME=replace_with_your_cloud_name
CLOUDINARY_API_KEY=replace_with_your_api_key
CLOUDINARY_API_SECRET=replace_with_your_api_secret
